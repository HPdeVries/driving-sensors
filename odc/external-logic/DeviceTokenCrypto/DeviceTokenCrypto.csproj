<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The OutSystems skill/docs state: use .NET 10 (.NET 8 support is ending; ODC then refuses libraries targeting it).
         If your tenant still requires net8.0, change this one line. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FlexLogic.DeviceTokenCrypto</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OutSystems.ExternalLibraries.SDK" Version="1.7.0" />
  </ItemGroup>
</Project>
